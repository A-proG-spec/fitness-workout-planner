# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/fitness_workout_planner?retryWrites=true&w=majority
# For local MongoDB, use: mongodb://localhost:27017/fitness_workout_planner
DB_URI=mongodb://localhost:27017/fitness_workout_planner

# JWT Settings
JWT_SECRET=your_super_secret_key_change_this_in_production_min_32_characters_long_for_security
JWT_EXPIRE=7d
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d
